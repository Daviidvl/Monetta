# Vercel project env vars (Settings > Environment Variables, never committed).
# Frontend and API share the same origin, so no CORS/base-URL vars are needed.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Frontend (Vite) — build-time, exposed in the PWA bundle. Anon key is safe
# to expose; Row Level Security is what protects the data, not this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
